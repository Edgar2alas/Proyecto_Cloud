# ====================================================
# CONFIGURACIÓN - waste-detection-backend
# Copia este archivo como .env.local y completa los valores
# ====================================================

# --- Google Cloud ---
# Ruta al archivo JSON de credenciales de tu Service Account de GCP
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# Nombre del bucket en Google Cloud Storage
GCS_BUCKET_NAME=la-paz-waste-images

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
